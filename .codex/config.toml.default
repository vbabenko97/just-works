# Codex CLI configuration — Direct OpenAI API
# Install: ./install.sh
# Manual: cp to ~/.codex/config.toml

model = "gpt-5.5"
# medium is OpenAI's general-purpose interactive default; reserve high/xhigh for the
# hardest work and set it per-invocation or per-agent instead of globally.
model_reasoning_effort = "medium"

[features]
multi_agent = true

[tui]
status_line = ["model-with-reasoning", "git-branch", "context-remaining"]
